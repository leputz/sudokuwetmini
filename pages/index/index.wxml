<!-- pages/index/index.wxml -->
<view class="container" style="padding: 20px;">
  <view style="margin-bottom: 20px;">
    <text>模型状态: {{isModelReady ? '✅ 已就绪' : '⏳ 加载中...'}}</text>
  </view>

  <button type="primary" bindtap="chooseImage" disabled="{{!isModelReady}}">
    拍照 / 选择数独图片
  </button>
  
  <!-- 原图预览 -->
  <view wx:if="{{imagePath}}" style="margin-top: 20px; text-align: center;">
    <image src="{{imagePath}}" mode="aspectFit" style="width: 100%; height: 250px; border-radius: 8px;"></image>
  </view>

  <!-- 识别结果展示 -->
  <view wx:if="{{recognizedBoard.length > 0}}" style="margin-top: 30px;">
    <view style="margin-bottom: 10px; font-weight: bold;">
      识别结果 (0为空白)
    </view>
    <view style="display: grid; grid-template-columns: repeat(9, 1fr); border: 2px solid #333; border-right: none; border-bottom: none;">
      <block wx:for="{{recognizedBoard}}" wx:for-item="row" wx:for-index="r" wx:key="r">
        <block wx:for="{{row}}" wx:for-item="cell" wx:for-index="c" wx:key="c">
          <view style="background: #fff; text-align: center; padding: 5px 0; font-size: 14px; border-right: 1px solid #ccc; border-bottom: 1px solid #ccc;">
            {{cell == 0 ? '' : cell}}
          </view>
        </block>
      </block>
    </view>
  </view>

   <!-- 求解结果合成图展示 -->
   <view wx:if="{{solvedImagePath}}" style="margin-top: 30px;">
    <view style="margin-bottom: 10px; font-weight: bold; color: #1aad19;">
      求解结果图 (绿色为填入数字)
    </view>
    <!-- 使用 mode="widthFix" 让图片按比例自适应宽度 -->
    <image src="{{solvedImagePath}}" mode="widthFix" style="width: 100%; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);"></image>
  </view>

  <!-- 新增：调试视图，显示切分出来的 81 个格子 -->
  <view wx:if="{{debugImageBase64}}" style="margin-top: 30px; padding: 10px; background: #f5f5f5; border-radius: 8px;">
    <view style="margin-bottom: 10px; font-weight: bold; color: #ff9800;">
      🐞 调试：切分后的 81 个格子 (用于检查预处理)
    </view>
    <image src="{{debugImageBase64}}" mode="widthFix" style="width: 100%; border: 1px solid #ccc;"></image>
    <button type="primary" bindtap="saveDebugImage" style="margin-top: 15px; font-size: 14px;">保存调试图到相册</button>
    <button type="default" bindtap="previewDebugImage" style="margin-top: 10px; font-size: 14px;">预览并长按保存</button>
  </view>
  
  <!-- 隐藏的 Canvas，必须在 DOM 中才能工作，用 opacity 和 z-index 隐藏更稳妥 -->
  <canvas type="2d" id="sudokuCanvas" style="position: absolute; top: 0; left: 0; width: 450px; height: 450px; opacity: 0; z-index: -1; pointer-events: none;"></canvas>
  <canvas type="2d" id="debugCanvas" style="position: absolute; top: 0; left: 0; width: 300px; height: 300px; opacity: 0; z-index: -1; pointer-events: none;"></canvas>
</view>